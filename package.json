{
  "name": "al2beat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:pyodide": "node scripts/sync-pyodide-assets.mjs",
    "sandbox:create-toolchain": "node --env-file-if-exists=.env.local scripts/create-toolchain-snapshot.mjs",
    "sandbox:verify-production": "node scripts/verify-production-runtimes.mjs",
    "sandbox:measure": "node --env-file-if-exists=.env.local scripts/measure-sandbox-runtimes.mjs",
    "solutions:verify-local": "node --conditions=react-server --experimental-strip-types scripts/verify-reference-solutions-local.mjs",
    "dev": "npm run prepare:pyodide && next dev",
    "build": "npm run prepare:pyodide && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --test --experimental-strip-types tests/content.test.ts tests/api.test.ts tests/review.test.ts tests/solutions.test.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@vercel/sandbox": "^3.5.1",
    "idb": "8.0.3",
    "lucide-react": "1.47.0",
    "monaco-editor": "0.57.0",
    "next": "16.3.6",
    "pyodide": "^314.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
