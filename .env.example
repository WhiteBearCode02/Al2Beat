# Vercel 배포에서는 OIDC가 자동 제공됩니다. 로컬 Sandbox 실행은 `vercel env pull`로
# 받은 VERCEL_OIDC_TOKEN이 필요하며 토큰을 저장소에 커밋하지 않습니다.
# C/C++/Java/C# 실행·채점에는 승인 후 생성한 도구 모음 스냅샷 ID도 필요합니다.
# AL2BEAT_TOOLCHAIN_SNAPSHOT_ID=snap_xxxxxxxxxxxx
# AL2BEAT_SANDBOX_REGION=iad1

# 서버 Sandbox 실행은 기본적으로 닫혀 있습니다. 비용 0원 보호를 위해 두 값을 함께 설정하고,
# 만료 시각은 현재 시각으로부터 최대 24시간 이내의 ISO 8601 값으로 지정하세요.
# AL2BEAT_PUBLIC_EXECUTION_ENABLED=ENABLE_HOBBY_SANDBOX
# AL2BEAT_EXECUTION_LEASE_EXPIRES_AT=2026-09-30T15:00:00.000Z

# 아래 확인 토큰은 실측 스크립트를 직접 실행할 때만 일회성으로 지정합니다.
# AL2BEAT_CONFIRM_SANDBOX_USAGE=MEASURE_RUNTIME_RESOURCES
